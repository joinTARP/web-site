---
import { desktopVersion } from '../data/site';
import { formatDate } from '../lib/blog';
import { getReleases } from '../lib/releases';

const releases = await getReleases();
---

{releases.length === 0 ? (
  <p class="mt-8 text-sm text-muted">暂无更新记录。</p>
) : (
  <ul
    class="mt-8 divide-y divide-line border-y border-line"
    aria-label="正式版本更新记录"
  >
    {releases.map((release) => (
      <li>
        <a
          href={`/releases/${release.data.version}/`}
          class="group flex flex-wrap items-center gap-x-5 gap-y-3 py-6 transition-colors hover:text-link"
        >
          <span class="font-mono text-lg font-medium">
            v{release.data.version}
          </span>
          {release.data.version === desktopVersion && (
            <span class="rounded border border-accent/20 bg-accent/10 px-2 py-0.5 text-xs text-accent">
              当前版本
            </span>
          )}
          <time
            class="ml-auto text-xs text-subtle"
            datetime={release.data.date.toISOString()}
          >
            {formatDate(release.data.date)}
          </time>
          <span
            class="text-subtle transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      </li>
    ))}
  </ul>
)}
