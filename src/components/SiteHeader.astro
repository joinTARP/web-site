---
import { nav } from '../data/site';
import Logo from './ui/Logo.astro';
import ThemeControl from './ThemeControl.astro';
import SourceLink from './SourceLink.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header
  transition:persist="site-header"
  transition:animate="none"
  class="group/header transition-none short-screen:data-ready:transition-transform short-screen:duration-220 short-screen:ease-[ease] short-screen:data-hidden:[transform:translateY(calc(-100%_-_16px))] motion-reduce:transition-none pointer-events-none fixed inset-x-0 top-0 z-50"
  data-header
>
  <div
    class="shell short-screen:group-data-hidden/header:pointer-events-none pointer-events-auto relative flex h-18 items-center justify-between gap-6 rounded-2xl border border-transparent transition-none group-data-ready/header:transition-[width,height,translate,padding,background-color,border-color,box-shadow] duration-300 ease-expo group-data-scrolled/header:h-15 group-data-scrolled/header:w-[min(900px,calc(100%-48px))] group-data-scrolled/header:translate-y-3 group-data-scrolled/header:border-line group-data-scrolled/header:bg-canvas/90 light:group-data-scrolled/header:bg-surface/95 group-data-scrolled/header:px-4 group-data-scrolled/header:shadow-[0_8px_32px_-12px_var(--color-shadow)] group-data-scrolled/header:backdrop-blur-xl sm:group-data-scrolled/header:px-5"
    data-header-panel
  >
    <a href="/" class="relative z-10" aria-label="TARP 首页">
      <Logo class="h-6 text-foreground transition-none group-data-ready/header:transition-[height] duration-300 ease-expo group-data-scrolled/header:h-5.5" />
    </a>

    <nav
      class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-2 lg:flex"
      aria-label="主导航"
    >
      {nav.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          aria-label={
            item.external ? `${item.label}（GitHub，新标签页）` : undefined
          }
          class="rounded-lg px-4 py-1.5 text-sm text-muted transition-colors hover:bg-foreground/8 hover:text-foreground aria-[current=page]:bg-foreground/8 aria-[current=page]:text-foreground"
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="relative z-10 flex items-center gap-3">
      <ThemeControl />
      <SourceLink />
      <button
        class="group/toggle relative grid size-11 place-items-center rounded-full border border-foreground/20 lg:hidden"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="打开菜单"
        data-menu-toggle
      >
        <span class="absolute h-px w-4 -translate-y-1 bg-foreground transition-transform duration-500 ease-expo group-aria-expanded/toggle:translate-y-0 group-aria-expanded/toggle:rotate-45"></span>
        <span class="absolute h-px w-4 translate-y-1 bg-foreground transition-transform duration-500 ease-expo group-aria-expanded/toggle:translate-y-0 group-aria-expanded/toggle:-rotate-45"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-49 h-svh bg-canvas transition-[clip-path] duration-700 ease-expo [clip-path:inset(0_0_100%_0)] data-open:[clip-path:inset(0)] lg:hidden"
  data-menu
  hidden
>
  <nav class="shell flex flex-col gap-1 pt-28" aria-label="移动端导航">
    {nav.map((item) => (
      <a
        href={item.href}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
        aria-label={
          item.external ? `${item.label}（GitHub，新标签页）` : undefined
        }
        class="border-b border-foreground/8 py-5 font-display text-2xl font-medium text-muted transition-colors hover:text-foreground aria-[current=page]:text-foreground"
        aria-current={isActive(item.href) ? 'page' : undefined}
        data-menu-link
      >
        {item.label}
      </a>
    ))}
  </nav>
</div>

<script>
  import '../scripts/header';
</script>
