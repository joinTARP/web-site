---
import logoSource from '../../../public/brand/tarp-logo.svg?raw';

interface Props {
  class?: string;
  animated?: boolean;
  gradient?: boolean;
  variant?: 'intro' | 'footer';
}

const {
  class: className,
  animated = false,
  gradient = false,
  variant = 'intro',
} = Astro.props;
const finale = variant === 'footer';
const viewBox = /viewBox="([^"]+)"/.exec(logoSource)?.[1] ?? '54 147 1837 527';
const [x = 54, y = 147, width = 1837, height = 527] = viewBox
  .split(/\s+/)
  .map(Number);

// 与桌面端一致，按字形左边缘排序；源路径仅含绝对坐标 M/C/Z。
const paths = Array.from(
  logoSource.matchAll(
    /\sd="([^"]+)"[^>]*?\stransform="translate\(([-\d.]+),([-\d.]+)\)"/g,
  ),
  ([, d = '', tx = '0', ty = '0']) => ({
    d,
    tx: Number(tx),
    ty: Number(ty),
    transform: `translate(${tx},${ty})`,
    left:
      Number(tx) +
      Math.min(
        ...(d.match(/-?\d*\.?\d+/g) ?? [])
          .filter((_, index) => index % 2 === 0)
          .map(Number),
      ),
  }),
).sort((a, b) => a.left - b.left);

const id = `logo-${crypto.randomUUID()}`;
const shineWidth = width * (finale ? 0.2 : 0.28);
const shineDistance = width + shineWidth + (finale ? height * 0.4 : 0);
---

{animated ? (
  <svg
    viewBox={viewBox}
    width={width}
    height={height}
    class:list={[
      'animated-logo block h-auto overflow-visible',
      { 'footer-logo': finale },
      className,
    ]}
    data-logo-finale={finale ? '' : undefined}
    style={`--shine-distance: ${shineDistance}px; --shine-delay: ${1.55 + (paths.length - 1) * 0.14}s`}
    aria-hidden="true"
  >
    <defs>
      {paths.map((path, index) => (
        <path id={`${id}-glyph-${index}`} d={path.d} pathLength="1" />
      ))}
      <clipPath id={`${id}-clip`}>
        {paths.map((path, index) => (
          <use href={`#${id}-glyph-${index}`} transform={path.transform} />
        ))}
      </clipPath>
      <linearGradient
        id={`${id}-shine`}
        class="logo-shine-gradient"
        x1="0"
        x2="1"
        y1="0"
        y2="0.18"
      >
        <stop offset="0" stop-opacity="0" />
        <stop offset="0.5" stop-opacity="0.75" />
        <stop offset="1" stop-opacity="0" />
      </linearGradient>
      {gradient &&
        paths.map((path, index) => (
          <linearGradient
            id={`${id}-fill-${index}`}
            gradientUnits="userSpaceOnUse"
            x1={x}
            y1={y}
            x2={x + width}
            y2={y + height}
            gradientTransform={`translate(${-path.tx},${-path.ty})`}
          >
            <stop offset="0" stop-color="var(--color-foreground)" />
            <stop offset="0.5" stop-color="var(--color-foreground)" />
            <stop offset="1" stop-color="var(--color-accent)" />
          </linearGradient>
        ))}
    </defs>
    {paths.map((path, index) => (
      <use
        class="logo-glyph"
        href={`#${id}-glyph-${index}`}
        transform={path.transform}
        fill={gradient ? `url(#${id}-fill-${index})` : 'currentColor'}
        stroke="currentColor"
        stroke-width="5"
        stroke-linejoin="round"
        style={`--glyph-delay: ${index * (finale ? 0.055 : 0.14)}s`}
      />
    ))}
    {finale && (
      <>
        {paths.map((path, index) => (
          <use
            class="logo-contour"
            href={`#${id}-glyph-${index}`}
            transform={path.transform}
            style={`--glyph-delay: ${index * 0.055}s`}
          />
        ))}
        {[0, 1].map((index) => (
          <g
            class="logo-echo"
            style={`--echo-delay: ${0.18 + index * 0.09}s; --echo-scale: ${1.065 + index * 0.04}`}
          >
            {paths.map((path, index) => (
              <use href={`#${id}-glyph-${index}`} transform={path.transform} />
            ))}
          </g>
        ))}
      </>
    )}
    <g clip-path={`url(#${id}-clip)`}>
      <rect
        class="logo-shine"
        x={x - shineWidth}
        y={y - height * 0.2}
        width={shineWidth}
        height={height * 1.4}
        fill={`url(#${id}-shine)`}
      />
    </g>
  </svg>
) : (
  <span
    class:list={[
      'block aspect-[1837/527] bg-current mask-[url(/brand/tarp-logo.svg)] mask-contain mask-center mask-no-repeat',
      className,
    ]}
  ></span>
)}

<style>
  .animated-logo {
    animation: logo-appear 1.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    transform-origin: center;
  }
  .logo-glyph {
    fill-opacity: 1;
    stroke-opacity: 0;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
    animation:
      logo-draw 1.2s cubic-bezier(0.65, 0, 0.35, 1) var(--glyph-delay) backwards,
      logo-fill 0.7s ease-out calc(0.85s + var(--glyph-delay)) backwards,
      logo-stroke-fade 0.5s ease-out calc(1.3s + var(--glyph-delay)) backwards;
  }
  .logo-shine-gradient stop {
    stop-color: var(--logo-shine-color, white);
  }
  .logo-shine-gradient stop:nth-child(2) {
    stop-opacity: var(--logo-shine-opacity, 0.75);
  }
  :global(.dark) .logo-shine-gradient stop {
    stop-color: var(--color-accent);
  }
  .logo-shine {
    opacity: 0;
    animation: logo-shine 1s cubic-bezier(0.45, 0, 0.2, 1) var(--shine-delay)
      backwards;
  }
  @keyframes logo-appear {
    from {
      opacity: 0;
      transform: scale(0.94);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }
  @keyframes logo-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes logo-fill {
    from {
      fill-opacity: 0;
    }
    to {
      fill-opacity: 1;
    }
  }
  @keyframes logo-stroke-fade {
    from {
      stroke-opacity: 1;
    }
    to {
      stroke-opacity: 0;
    }
  }
  @keyframes logo-shine {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 1;
      transform: translateX(var(--shine-distance));
    }
  }
  /* 页脚保持静态，只有抽屉完全展开后才由 data-playing 播放。 */
  .footer-logo,
  .footer-logo .logo-glyph,
  .footer-logo .logo-shine {
    animation: none;
  }
  .footer-logo .logo-shine-gradient stop {
    stop-color: var(--color-foreground);
  }
  .footer-logo .logo-shine-gradient stop:nth-child(2) {
    stop-opacity: 1;
  }
  .logo-contour {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 8;
    stroke-linejoin: round;
    stroke-opacity: 0;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    filter: drop-shadow(0 0 10px var(--color-accent));
  }
  .logo-echo {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
    stroke-linejoin: round;
    opacity: 0;
    transform-box: view-box;
    transform-origin: center;
  }
  .footer-logo[data-playing] {
    animation: footer-impact 980ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .footer-logo[data-playing] .logo-glyph {
    animation: footer-glyph 780ms cubic-bezier(0.16, 1, 0.3, 1)
      var(--glyph-delay) both;
  }
  .footer-logo[data-playing] .logo-contour {
    animation:
      logo-draw 550ms cubic-bezier(0.65, 0, 0.35, 1) var(--glyph-delay) both,
      footer-contour 820ms ease-out var(--glyph-delay) both;
  }
  .footer-logo[data-playing] .logo-echo {
    animation: footer-echo 650ms cubic-bezier(0.16, 1, 0.3, 1) var(--echo-delay)
      both;
  }
  .footer-logo[data-playing] .logo-shine {
    animation: footer-shine 650ms cubic-bezier(0.45, 0, 0.2, 1) 330ms both;
  }
  @keyframes footer-impact {
    0% {
      transform: scale(0.985);
      filter: drop-shadow(0 0 0 transparent);
    }
    30% {
      transform: scale(1.025);
      filter: drop-shadow(0 0 14px var(--color-accent))
        drop-shadow(
          0 0 36px color-mix(in srgb, var(--color-accent) 55%, transparent)
        );
    }
    100% {
      transform: scale(1);
      filter: drop-shadow(0 0 0 transparent);
    }
  }
  @keyframes footer-glyph {
    0% {
      fill: currentColor;
      fill-opacity: 0.18;
    }
    28% {
      fill: var(--color-accent);
      fill-opacity: 1;
    }
    52% {
      fill: var(--color-foreground);
      fill-opacity: 1;
    }
    100% {
      fill: currentColor;
      fill-opacity: 1;
    }
  }
  @keyframes footer-contour {
    0% {
      stroke-opacity: 0;
    }
    18%,
    52% {
      stroke-opacity: 1;
    }
    100% {
      stroke-opacity: 0;
    }
  }
  @keyframes footer-echo {
    0% {
      opacity: 0;
      transform: scale(1);
    }
    15% {
      opacity: 0.65;
    }
    100% {
      opacity: 0;
      transform: scale(var(--echo-scale));
    }
  }
  @keyframes footer-shine {
    0% {
      opacity: 0;
      transform: translateX(0) skewX(-18deg);
    }
    15%,
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(var(--shine-distance)) skewX(-18deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .animated-logo,
    .logo-glyph,
    .logo-shine,
    .footer-logo[data-playing],
    .footer-logo[data-playing] .logo-glyph,
    .footer-logo[data-playing] .logo-contour,
    .footer-logo[data-playing] .logo-echo,
    .footer-logo[data-playing] .logo-shine {
      animation: none;
    }
  }
</style>
