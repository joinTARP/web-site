---
type Agent = {
  name: string;
  icon: string;
  href: string;
  accentClass: string;
  maskClass?: string;
  colored?: boolean;
};

const agents: Agent[] = [
  {
    name: 'Codex',
    icon: 'codex.svg',
    href: 'https://openai.com/codex/',
    accentClass: '[--agent-accent:var(--color-foreground)]',
    maskClass: 'mask-[url(/brand/agents/codex.svg)]',
  },
  {
    name: 'Claude Code',
    icon: 'claude-code.svg',
    href: 'https://claude.com/product/claude-code',
    accentClass: '[--agent-accent:#d97757] light:[--agent-accent:#b96446]',
    maskClass: 'mask-[url(/brand/agents/claude-code.svg)]',
  },
  {
    name: 'Cursor',
    icon: 'cursor.svg',
    href: 'https://cursor.com/',
    accentClass: '[--agent-accent:var(--color-foreground)]',
    maskClass: 'mask-[url(/brand/agents/cursor.svg)]',
  },
  {
    name: 'pi',
    icon: 'pi.svg',
    href: 'https://pi.dev/',
    accentClass: '[--agent-accent:#f09082]',
    colored: true,
  },
  {
    name: 'OpenCode',
    icon: 'opencode.svg',
    href: 'https://opencode.ai/',
    accentClass: '[--agent-accent:var(--color-foreground)]',
    maskClass: 'mask-[url(/brand/agents/opencode.svg)]',
  },
  {
    name: 'TRAE',
    icon: 'trae.svg',
    href: 'https://www.trae.cn/',
    accentClass: '[--agent-accent:#43d897] light:[--agent-accent:#168257]',
    maskClass: 'mask-[url(/brand/agents/trae.svg)]',
  },
  {
    name: 'CodeBuddy',
    icon: 'codebuddy.svg',
    href: 'https://www.codebuddy.cn/',
    accentClass: '[--agent-accent:#78a8ff] light:[--agent-accent:#4375c4]',
    maskClass: 'mask-[url(/brand/agents/codebuddy.svg)]',
  },
  {
    name: 'ZCode',
    icon: 'zcode.png',
    href: 'https://zcode.z.ai/cn',
    accentClass: '[--agent-accent:var(--color-foreground)]',
    colored: true,
  },
  {
    name: 'Kimi Code',
    icon: 'kimi-code.svg',
    href: 'https://github.com/MoonshotAI/kimi-code',
    accentClass: '[--agent-accent:#7c9aff] light:[--agent-accent:#4e6dbe]',
    maskClass: 'mask-[url(/brand/agents/kimi-code.svg)]',
  },
];
---

<ul
  class="grid list-none grid-cols-3 gap-3.5 pt-8 pb-5 max-lg:gap-2 compact:gap-1"
  aria-label="可用于编写模组的智能体"
>
  {agents.map((agent) => (
    <li data-agent-tile>
      <a
        class:list={[
          'group/agent light:border-line/80 light:bg-surface/80 light:shadow-tile interactive:light:shadow-tile-hover relative isolate flex min-h-40 flex-col items-center justify-center gap-4.5 rounded-[14px] border border-transparent px-3 pt-6 pb-4.5 text-subtle [transition:transform_450ms_var(--ease-smooth),background-color_350ms_ease,border-color_350ms_ease,box-shadow_350ms_ease,color_350ms_ease] interactive:-translate-y-[5px] interactive:border-(--agent-accent)/20 interactive:bg-surface interactive:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent max-lg:min-h-[145px] max-lg:px-1.5 compact:min-h-[135px] compact:gap-3.5 compact:px-1 motion-reduce:transition-none motion-reduce:interactive:translate-y-0',
          agent.accentClass,
        ]}
        href={agent.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={agent.name + '（打开官网）'}
      >
        <span
          class="pointer-events-none absolute top-[17px] left-[calc(50%-32px)] -z-1 size-16 scale-75 rounded-full bg-(--agent-accent)/22 opacity-0 blur-[18px] transition-[opacity,transform] duration-450 ease-[ease] group-interactive/agent:scale-100 group-interactive/agent:opacity-100 motion-reduce:transition-none"
          aria-hidden="true"
        />
        <span
          class:list={[
            'block size-11 shrink-0 opacity-55 light:opacity-80 transition-[opacity,transform,background-color] duration-450 ease-smooth group-interactive/agent:scale-108 group-interactive/agent:opacity-100 compact:size-9 [@media(hover:none)]:opacity-85 motion-reduce:transition-none motion-reduce:group-interactive/agent:scale-100',
            !agent.colored &&
              'bg-muted mask-contain mask-center mask-no-repeat group-interactive/agent:bg-(--agent-accent)',
            agent.maskClass,
          ]}
          aria-hidden="true"
        >
          {agent.colored && (
            <img
              class="size-full object-contain grayscale transition-[filter] duration-350 ease-[ease] group-interactive/agent:grayscale-0 motion-reduce:transition-none"
              src={'/brand/agents/' + agent.icon}
              width="44"
              height="44"
              loading="lazy"
              decoding="async"
              alt=""
            />
          )}
        </span>
        <span class="block min-h-9 text-center text-[13px] leading-[18px] max-lg:text-xs">
          {agent.name}
        </span>
      </a>
    </li>
  ))}
</ul>
