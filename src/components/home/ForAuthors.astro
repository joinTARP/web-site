<script>
  import { gsap, ScrollTrigger } from '../../scripts/animation';
  const section = document.querySelector<HTMLElement>('#authors');
  if (section) {
    const itemDialog = section.querySelector<HTMLDialogElement>(
      '#author-item-detail',
    )!;
    const itemOpen =
      section.querySelector<HTMLButtonElement>('[data-item-open]')!;
    itemOpen.disabled = false;
    itemOpen.addEventListener('click', () => itemDialog.showModal());

    const encounterButton = section.querySelector<HTMLButtonElement>(
      '[data-encounter-button]',
    )!;
    const creature = section.querySelector<HTMLElement>('[data-encountered]')!;
    const trait = section.querySelector<HTMLElement>('[data-encounter-trait]')!;
    const encounterStatus = section.querySelector<HTMLElement>(
      '[data-encounter-status]',
    )!;
    const encounterValue = section.querySelector<HTMLElement>(
      '[data-encounter-value]',
    )!;
    encounterButton.disabled = false;
    encounterButton.addEventListener(
      'click',
      () => {
        if (creature.dataset.encountered === 'true') return;
        creature.dataset.encountered = 'true';
        encounterValue.textContent = 'true';
        encounterValue.dataset.marked = '';
        encounterStatus.textContent = '已遭遇 · 正在揭示特性';
        encounterButton.disabled = true;
        encounterButton.dataset.complete = '';
        encounterButton.textContent = '✓ 已遭遇';
        const reveal = () => {
          trait.textContent = '畏惧火焰';
          trait.className =
            'revealed-trait mt-3.5 block text-[21px] font-medium tracking-[0.15em] text-accent max-md:text-[17px]';
          encounterStatus.textContent = '已遭遇 · 特性已揭示';
        };
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveal();
        } else {
          window.setTimeout(reveal, 450);
        }
      },
      { once: true },
    );

    const scenes = Array.from(
      section.querySelectorAll<HTMLElement>('[data-author-scene]'),
    );

    const indexNav = section.querySelector<HTMLElement>('.authors-index')!;
    const indexLinks = Array.from(
      section.querySelectorAll<HTMLAnchorElement>('[data-author-index]'),
    );
    let activeIndex = -1;
    const syncIndex = () => {
      let next = 0;
      scenes.forEach((scene, index) => {
        if (scene.getBoundingClientRect().top <= window.innerHeight * 0.48)
          next = index;
      });
      if (next === activeIndex) return;
      activeIndex = next;
      indexNav.style.setProperty('--active-step', String(next));
      indexLinks.forEach((link, index) => {
        if (index === next) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
    };
    ScrollTrigger.create({
      trigger: section,
      start: 'top bottom',
      end: 'bottom top',
      onUpdate: syncIndex,
      onRefresh: syncIndex,
    });
    syncIndex();
    indexLinks.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        scenes[index]?.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
            .matches
            ? 'instant'
            : 'smooth',
          block: 'start',
        });
      });
    });

    gsap.matchMedia().add(
      {
        desktop: '(min-width: 1024px)',
        motion: '(prefers-reduced-motion: no-preference)',
      },
      (context) => {
        if (!context.conditions?.motion) return;
        const desktop = context.conditions.desktop;
        scenes.forEach((scene) => {
          const agentTiles =
            scene.querySelectorAll<HTMLElement>('[data-agent-tile]');
          if (agentTiles.length) {
            gsap.fromTo(
              agentTiles,
              { y: 24, opacity: 0.2 },
              {
                y: 0,
                opacity: 1,
                duration: 0.8,
                stagger: 0.04,
                ease: 'power2.out',
                scrollTrigger: {
                  trigger: scene,
                  start: 'top 85%',
                  end: 'center 65%',
                  scrub: 0.6,
                  invalidateOnRefresh: true,
                },
              },
            );
            return;
          }
          const definition =
            scene.querySelector<HTMLElement>('[data-definition]')!;
          const entity = scene.querySelector<HTMLElement>('[data-entity]')!;
          const connector =
            scene.querySelector<HTMLElement>('[data-connector]')!;
          const timeline = gsap.timeline({
            scrollTrigger: {
              trigger: scene,
              start: 'top 85%',
              end: 'top 12%',
              scrub: 0.6,
              invalidateOnRefresh: true,
            },
          });
          timeline
            .fromTo(
              definition,
              { x: desktop ? -70 : -20, y: 25, rotation: -6, opacity: 0.3 },
              { x: 0, y: 0, rotation: -3, opacity: 1, duration: 0.4 },
              0,
            )
            .fromTo(
              connector,
              { scaleX: 0, opacity: 0 },
              { scaleX: 1, opacity: 1, duration: 0.25 },
              0.2,
            )
            .fromTo(
              entity,
              { x: desktop ? -100 : -35, y: 35, rotation: -5, opacity: 0 },
              { x: 0, y: 0, rotation: 2, opacity: 1, duration: 0.45 },
              0.25,
            );
          const before = scene.querySelector<HTMLElement>('[data-before]');
          const after = scene.querySelector<HTMLElement>('[data-after]');
          if (before && after) {
            timeline
              .fromTo(
                before,
                { opacity: 1 },
                { opacity: 0, duration: 0.25 },
                0.72,
              )
              .fromTo(
                after,
                { opacity: 0, y: 10 },
                { opacity: 1, y: 0, duration: 0.3 },
                0.78,
              );
            const bonus = scene.querySelector<HTMLElement>('[data-bonus]');
            if (bonus)
              timeline.fromTo(
                bonus,
                { scaleX: 0 },
                { scaleX: 1, duration: 0.3 },
                0.78,
              );
          }
        });
      },
    );
  }
</script>

<style>
  .creature-card[data-encountered='true'] .revealed-trait {
    animation: trait-reveal 450ms ease-out;
  }
  @keyframes trait-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .creature-card[data-encountered='true'] .revealed-trait {
      animation: none;
    }
  }
  .condition-label code[data-marked] {
    animation: encounter-mark 450ms ease-out;
  }
  @keyframes encounter-mark {
    0% {
      box-shadow: 0 0 0 0 transparent;
    }
    40% {
      box-shadow: 0 0 0 6px
        color-mix(in srgb, var(--color-success) 20%, transparent);
    }
    100% {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .condition-label code[data-marked] {
      animation: none;
    }
  }
</style>
