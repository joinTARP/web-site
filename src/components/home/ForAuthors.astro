---
import { Image } from 'astro:assets';
import blade from '../../assets/demo/night-blade.png';
import torch from '../../assets/demo/torch.webp';
import stalker from '../../assets/demo/mist-stalker.png';
import { Code } from 'astro:components';
import AgentGallery from './AgentGallery.astro';
const darkFormula = `$definition.base_damage +
(load($self.location)?.dark ? " + 5" : "")`;
const traitFormula = `$self.encountered
  ? $self.hidden_traits
  : "？？？"`;
const fieldDefinition = `[fields.category]
type = "enum"
options = ["单手剑", "长弓"]

[fields.base_damage]
type = "text"
label = "基础伤害"

[fields.weight]
type = "number"
label = "重量"`;
const darkFields = `[fields.location]
type = "reference"
label = "所在场景"
targets = ["场景"]
required = true
mutable = true`;
const darkDocument = `name = "夜行刃"
base_damage = "1d6"

[instance.fields.damage]
type = "text"
label = "伤害"
compute = '''
${darkFormula}
'''`;
const traitDefinition = `[fields.traits]
type = "text"
label = "特性"
compute = '''
${traitFormula}
'''`;
const authorSteps = [
  { id: 'author-fields', label: '超高自由度' },
  { id: 'author-references', label: '引用文档' },
  { id: 'author-compute', label: '自动计算数值' },
  { id: 'author-reveal', label: '按条件展示特性' },
  { id: 'author-building', label: '用 AI 写模组' },
];
const linkExample = `---
name: 火把
---

点火、熄灭与燃烧余量
详见 [[规则/光照]]。`;
---

<section
  id="authors"
  class="authors-section pt-25 pb-20 bg-canvas px-0 max-md:py-[65px]"
  aria-labelledby="authors-title"
>
  <div class="shell authors-layout grid grid-cols-[minmax(250px,_0.75fr)_minmax(0,_1.65fr)] gap-[clamp(35px,_5vw,_80px)] items-start max-lg:grid-cols-[minmax(210px,_0.65fr)_minmax(0,_1.35fr)] max-lg:gap-7.5 max-md:block">
    <div class="authors-copy sticky top-[max(140px,_28vh)] pb-[35px] [&_h2]:text-[clamp(30px,_3vw,_40px)] [&_h2]:leading-[1.4] [&_h2]:tracking-[-0.035em] [&_h2]:font-semibold [&_h2_span]:block [&_h2_span]:mt-2 [&_h2_span]:text-accent max-lg:[&_h2]:text-[29px] max-md:static max-md:[&_h2]:text-[32px] motion-reduce:static [&_.authors-intro]:mt-[25px] [&_.authors-intro]:leading-[2] [&_.authors-intro]:text-pretty [&_.authors-link]:mt-7.5 [&_.authors-link]:pb-2 [&_.authors-link]:border-b [&_.authors-link]:border-b-line max-md:[&_h2_span]:ml-0 md:top-[max(105px,_16vh)]">
      <h2 id="authors-title">
        自定义规则，
        <span>创造你的玩法。</span>
      </h2>
      <p class="authors-intro text-[15px] leading-[1.95] text-muted max-w-72.5 mt-5.5 max-md:max-w-85">
        自定义文档字段，引用相关资料，用表达式计算数值、控制信息展示。
      </p>
      <nav
        class="authors-index [--active-step:0] relative grid mt-7.5 pl-[19px] border-l border-l-line [&_a]:flex [&_a]:items-center [&_a]:min-h-11 [&_a]:text-subtle [&_a]:text-[13px] [&_a]:[transition:color_400ms_ease,_transform_500ms_cubic-bezier(0.22,_1,_0.36,_1)] [&_a[aria-current='step']]:text-foreground [&_a[aria-current='step']]:[transform:translateX(8px)] [&_a:hover]:text-foreground max-md:grid-cols-[1fr_1fr] max-md:gap-[0_16px] max-md:pl-0 max-md:border-l-0 max-md:[&_a]:border-b max-md:[&_a]:border-b-line max-md:[&_a[aria-current='step']]:[transform:none] max-md:[&_a[aria-current='step']]:border-accent motion-reduce:[&_a]:[transition:none]"
        aria-label="模组能力索引"
      >
        <span
          class="index-indicator absolute top-[9px] left-[-1px] w-0.5 h-6.5 bg-accent [transform:translateY(calc(var(--active-step)_*_44px))] [transition:transform_550ms_cubic-bezier(0.22,_1,_0.36,_1)] max-md:hidden motion-reduce:[transition:none]"
          aria-hidden="true"
        ></span>
        {authorSteps.map((step, index) => (
          <a
            href={`#${step.id}`}
            data-author-index={index}
            aria-current={index === 0 ? 'step' : undefined}
          >
            {step.label}
          </a>
        ))}
      </nav>
      <a
        href="/docs/modules/compute/"
        class="authors-link inline-flex gap-[25px] text-[12px] mt-[35px] text-muted hover:text-foreground max-md:mt-5"
      >
        了解计算字段 <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="authors-story min-w-0">
      <article
        class="author-scene min-h-165 pt-[65px] pb-[115px] flex flex-col justify-center [scroll-margin-top:110px] max-md:min-h-auto max-md:pt-[45px] max-md:pb-15 px-0 max-md:px-0"
        id="author-fields"
        data-author-scene="0"
        aria-labelledby="field-scene-title"
      >
        <header class="scene-heading [&_>_span]:text-subtle [&_>_span]:text-[11px] [&_>_span]:tracking-[0.04em] [&_h3]:text-[21px] [&_h3]:leading-[1.5] [&_h3]:font-medium [&_h3]:mt-0 [&_h3]:tracking-[-0.02em] max-lg:[&_h3]:text-[18px]">
          <h3 id="field-scene-title">DIY 物品的各种属性。</h3>
        </header>
        <div class="definition-flow grid grid-cols-[minmax(0,_1.05fr)_42px_minmax(0,_1fr)] items-center pt-10.5 pb-7 isolate max-lg:grid-cols-[minmax(0,_1fr)_22px_minmax(0,_1fr)] max-md:pt-7.5 max-md:gap-0 max-md:grid-cols-[minmax(0,_1fr)] px-2 max-lg:px-0 max-md:px-2">
          <div
            class="definition-card light:shadow-panel min-w-0 border border-line bg-surface shadow-[0_20px_45px_-32px_var(--color-shadow)] rounded-[3px] [transform:rotate(-3deg)] z-1 max-md:w-[92%] p-5 max-lg:p-[15px] max-md:p-5"
            data-definition
          >
            <div class="paper-heading flex items-center gap-[9px] pb-[17px] border-b border-b-line text-[11px] text-muted max-md:gap-[5px] max-md:text-[11px]">
              <svg
                class="size-4 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                <path d="M14 2v6h6" />
              </svg>
              <span class="file-name min-w-0 wrap-anywhere font-mono text-[10px] max-md:text-[11px]">
                types/物品.fields.toml
              </span>
            </div>
            <div class="formula-code schema-code pt-5.5 pb-5.5 [&_pre]:bg-transparent! [&_pre]:text-[11px] [&_pre]:leading-[1.9] [&_pre]:whitespace-pre-wrap [&_pre]:wrap-anywhere max-md:[&_pre]:text-[11px] pt-3 pb-0">
              <Code code={fieldDefinition} lang="toml" theme="css-variables" />
            </div>
          </div>
          <div
            class="flow-connector flex items-center origin-left text-accent z-2 [&_>_span]:flex-1 [&_>_span]:h-[1px] [&_>_span]:bg-accent [&_>_span]:opacity-[0.5] [&_b]:text-[17px] [&_b]:font-normal [&_b]:-ml-0.5 max-md:w-8.5 max-md:h-10.5 max-md:ml-[55%] max-md:[transform:rotate(90deg)]"
            aria-hidden="true"
            data-connector
          >
            <span></span>
            <b>→</b>
          </div>
          <div
            class="entity-card light:bg-surface light:shadow-panel weapon-card min-w-0 border border-line bg-canvas shadow-[0_20px_45px_-32px_var(--color-shadow)] rounded-[3px] relative [transform:rotate(2deg)] min-h-85 [&_h4]:text-[23px] [&_h4]:font-medium [&_h4]:tracking-[0.09em] max-md:min-h-[315px] max-md:w-[85%] max-md:justify-self-end max-md:[&_h4]:text-[20px] [&_.weapon-art]:w-full [&_.weapon-art]:h-45 [&_.weapon-art]:mt-3 [&_.weapon-art]:mb-[15px] p-5 max-lg:p-[15px] max-md:p-5 [&_.weapon-art]:mx-auto"
            data-entity
          >
            <div class="weapon-art mt-[5px] mb-[-5px] text-accent max-lg:w-[125px] max-md:w-37.5 max-md:h-[155px] [&_img]:object-contain mx-auto size-[155px] [&_svg]:size-full [&_img]:size-full">
              <Image
                src={blade}
                format="webp"
                quality={80}
                widths={[240, 480]}
                sizes="240px"
                width={480}
                alt="夜行刃，暗钢剑身带冷蓝刃光的单手剑"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h4>夜行刃</h4>
            <p class="entity-subtitle text-subtle text-[10px] mt-1.5">
              武器 · 单手剑
            </p>
            <dl class="entity-stats flex gap-[35px] mt-[19px] pt-3.5 border-t border-t-line [&_dt]:text-[9px] [&_dt]:text-muted [&_dd]:font-mono [&_dd]:font-normal [&_dd]:text-[21px] [&_dd]:leading-[normal] [&_dd]:mt-2 max-lg:gap-5 max-md:gap-4.5">
              <div>
                <dt>基础伤害</dt>
                <dd>1d6</dd>
              </div>
              <div>
                <dt>重量</dt>
                <dd>2</dd>
              </div>
            </dl>
          </div>
        </div>
        <p class="scene-caption text-[12px] leading-[1.9] text-subtle mt-5 max-md:mt-1.5 max-md:text-[11px]">
          定义字段和类型，再为每件物品填写对应的值。
        </p>
      </article>

      <article
        class="author-scene min-h-165 pt-[65px] pb-[115px] flex flex-col justify-center [scroll-margin-top:110px] max-md:min-h-auto max-md:pt-[45px] max-md:pb-15 px-0 max-md:px-0"
        id="author-references"
        data-author-scene="1"
        aria-labelledby="link-scene-title"
      >
        <header class="scene-heading [&_>_span]:text-subtle [&_>_span]:text-[11px] [&_>_span]:tracking-[0.04em] [&_h3]:text-[21px] [&_h3]:leading-[1.5] [&_h3]:font-medium [&_h3]:mt-0 [&_h3]:tracking-[-0.02em] max-lg:[&_h3]:text-[18px]">
          <h3 id="link-scene-title">文档之间可以相互引用。</h3>
        </header>
        <div class="definition-flow grid grid-cols-[minmax(0,_1.05fr)_42px_minmax(0,_1fr)] items-center pt-10.5 pb-7 isolate max-lg:grid-cols-[minmax(0,_1fr)_22px_minmax(0,_1fr)] max-md:pt-7.5 max-md:gap-0 max-md:grid-cols-[minmax(0,_1fr)] px-2 max-lg:px-0 max-md:px-2">
          <div
            class="definition-card light:shadow-panel min-w-0 border border-line bg-surface shadow-[0_20px_45px_-32px_var(--color-shadow)] rounded-[3px] [transform:rotate(-3deg)] z-1 max-md:w-[92%] p-5 max-lg:p-[15px] max-md:p-5"
            data-definition
          >
            <div class="paper-heading flex items-center gap-[9px] pb-[17px] border-b border-b-line text-[11px] text-muted max-md:gap-[5px] max-md:text-[11px]">
              <svg
                class="size-4 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                <path d="M14 2v6h6" />
              </svg>
              <span class="file-name min-w-0 wrap-anywhere font-mono text-[10px] max-md:text-[11px]">
                物品/火把.md
              </span>
            </div>
            <div class="formula-code [&_pre]:bg-transparent! [&_pre]:text-[11px] [&_pre]:leading-[1.9] [&_pre]:whitespace-pre-wrap [&_pre]:wrap-anywhere max-md:[&_pre]:text-[11px] py-5.5">
              <Code code={linkExample} lang="md" theme="css-variables" />
            </div>
          </div>
          <div
            class="flow-connector flex items-center origin-left text-accent z-2 [&_>_span]:flex-1 [&_>_span]:h-[1px] [&_>_span]:bg-accent [&_>_span]:opacity-[0.5] [&_b]:text-[17px] [&_b]:font-normal [&_b]:-ml-0.5 max-md:w-8.5 max-md:h-10.5 max-md:ml-[55%] max-md:[transform:rotate(90deg)]"
            aria-hidden="true"
            data-connector
          >
            <span></span>
            <b>→</b>
          </div>
          <div
            class="entity-card light:bg-surface light:shadow-panel reference-card min-w-0 border border-line bg-canvas shadow-[0_20px_45px_-32px_var(--color-shadow)] rounded-[3px] relative [transform:rotate(2deg)] min-h-85 [&_h4]:text-[23px] [&_h4]:font-medium [&_h4]:tracking-[0.09em] max-md:min-h-[315px] max-md:w-[85%] max-md:justify-self-end max-md:[&_h4]:text-[20px] [&_.entity-stats]:gap-4.5 [&_.entity-stats_dd]:text-[16px] [&_.reference-prose]:mt-5 [&_.reference-prose]:text-[12px] [&_.reference-prose]:leading-[1.9] p-5 max-lg:p-[15px] max-md:p-5"
            data-entity
          >
            <div class="torch-art h-[155px] mt-3 mb-[15px] [&_img]:block [&_img]:object-contain mx-auto [&_img]:size-full">
              <Image
                src={torch}
                format="webp"
                quality={80}
                widths={[200, 400]}
                sizes="200px"
                width={400}
                alt="燃烧的火把"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h4>火把</h4>
            <p class="entity-subtitle text-subtle text-[10px] mt-1.5">
              消耗品 · 光源
            </p>
            <dl class="entity-stats flex gap-[35px] mt-[19px] pt-3.5 border-t border-t-line [&_dt]:text-[9px] [&_dt]:text-muted [&_dd]:font-mono [&_dd]:font-normal [&_dd]:text-[21px] [&_dd]:leading-[normal] [&_dd]:mt-2 max-lg:gap-5 max-md:gap-4.5">
              <div>
                <dt>照明范围</dt>
                <dd>约 6 米</dd>
              </div>
              <div>
                <dt>累计燃烧</dt>
                <dd>60 分钟</dd>
              </div>
            </dl>
            <p class="reference-prose text-[13px] leading-[2.3] mt-7">
              点火、熄灭与燃烧余量详见{' '}
              <span class="wiki-reference relative inline-block [&:hover_.wiki-tooltip]:visible [&:hover_.wiki-tooltip]:opacity-[1] [&:focus-within_.wiki-tooltip]:visible [&:focus-within_.wiki-tooltip]:opacity-[1]">
                <button
                  type="button"
                  class="wiki-link cursor-pointer text-link border-b border-dashed border-b-accent leading-[1.7] [&_span]:text-[10px]"
                  data-item-open
                  aria-haspopup="dialog"
                  aria-controls="author-item-detail"
                  disabled
                >
                  光照 <span aria-hidden="true">↗</span>
                </button>
                <span
                  class="wiki-tooltip absolute bottom-[calc(100%_+_10px)] -left-4.5 z-5 w-[175px] bg-surface-raised border border-line rounded-[4px] shadow-[0_8px_24px_-10px_var(--color-shadow)] invisible opacity-[0] pointer-events-none [&_strong]:block [&_strong]:text-[12px] [&_strong]:font-medium [&_>_span]:block [&_>_span]:text-[9px] [&_>_span]:text-muted [&_>_span]:mt-[5px] p-[13px]"
                  aria-hidden="true"
                >
                  <strong>光照</strong>
                  <span>照明范围、燃烧余量与黑暗中的行动。</span>
                </span>
              </span>
              。
            </p>
            <div class="reference-path flex gap-2 text-subtle text-[9px] mt-6.5 pt-[15px] border-t border-t-line">
              <span aria-hidden="true">↳</span>
              <span>规则 / 光照</span>
            </div>
            <p class="reference-hint text-[9px] text-subtle mt-4">
              悬停预览 · 点击查看规则
            </p>
          </div>
        </div>
        <p class="scene-caption text-[12px] leading-[1.9] text-subtle mt-5 max-md:mt-1.5 max-md:text-[11px]">
          在火把文档中写入 [[规则/光照]]，卡片正文会显示可点击的“光照”链接。
        </p>
      </article>

      <article
        class="author-scene min-h-165 pt-[65px] pb-[115px] flex flex-col justify-center [scroll-margin-top:110px] max-md:min-h-auto max-md:pt-[45px] max-md:pb-15 px-0 max-md:px-0"
        id="author-compute"
        data-author-scene="2"
        aria-labelledby="dark-scene-title"
      >
        <header class="scene-heading [&_>_span]:text-subtle [&_>_span]:text-[11px] [&_>_span]:tracking-[0.04em] [&_h3]:text-[21px] [&_h3]:leading-[1.5] [&_h3]:font-medium [&_h3]:mt-0 [&_h3]:tracking-[-0.02em] max-lg:[&_h3]:text-[18px]">
          <h3 id="dark-scene-title">场景变暗，夜行刃的伤害 +5。</h3>
        </header>
        <div class="definition-flow grid grid-cols-[minmax(0,_1.05fr)_42px_minmax(0,_1fr)] items-center pt-10.5 pb-7 isolate max-lg:grid-cols-[minmax(0,_1fr)_22px_minmax(0,_1fr)] max-md:pt-7.5 max-md:gap-0 max-md:grid-cols-[minmax(0,_1fr)] px-2 max-lg:px-0 max-md:px-2">
          <div
            class="definition-card light:shadow-panel formula-card min-w-0 border border-line bg-surface shadow-[0_20px_45px_-32px_var(--color-shadow)] rounded-[3px] [transform:rotate(-3deg)] z-1 max-md:w-[92%] p-5 max-lg:p-[15px] max-md:p-5"
            data-definition
          >
            <div class="paper-heading flex items-center gap-[9px] pb-[17px] border-b border-b-line text-[11px] text-muted max-md:gap-[5px] max-md:text-[11px]">
              <svg
                class="size-4 shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
                <path d="M14 2v6h6" />
              </svg>
              <span class="file-name min-w-0 wrap-anywhere font-mono text-[10px] max-md:text-[11px]">
                物品/夜行刃.toml
              </span>
            </div>
            <div class="formula-code [&_pre]:bg-transparent! [&_pre]:text-[11px] [&_pre]:leading-[1.9] [&_pre]:whitespace-pre-wrap [&_pre]:wrap-anywhere max-md:[&_pre]:text-[11px] py-5.5">
              <Code code={darkDocument} lang="toml" theme="css-variables" />
            </div>
            <details class="border-t border-line pt-3 pb-4 text-[10px] text-subtle">
              <summary class="cursor-pointer hover:text-foreground">
                查看持有者的位置字段 · .types/角色.fields.toml
              </summary>
              <div class="formula-code pt-3 [&_pre]:bg-transparent! [&_pre]:text-[11px] [&_pre]:leading-[1.9] [&_pre]:whitespace-pre-wrap [&_pre]:wrap-anywhere">
                <Code code={darkFields} lang="toml" theme="css-variables" />
              </div>
            </details>
          </div>
          <div
            class="flow-connector flex items-center origin-left text-accent z-2 [&_>_span]:flex-1 [&_>_span]:h-[1px] [&_>_span]:bg-accent [&_>_span]:opacity-[0.5] [&_b]:text-[17px] [&_b]:font-normal [&_b]:-ml-0.5 max-md:w-8.5 max-md:h-10.5 max-md:ml-[55%] max-md:[transform:rotate(90deg)]"
            aria-hidden="true"
            data-connector
          >
            <span></span>
            <b>→</b>
          </div>
          <div
            class="entity-card attack-card group relative min-w-0 overflow-hidden rounded-[3px] border border-line bg-surface p-5 shadow-panel [transform:rotate(2deg)] max-lg:p-[15px] max-md:w-[85%] max-md:justify-self-end max-md:p-5"
            data-entity
            data-dark="true"
          >
            <div class="relative flex h-44 items-center justify-center overflow-hidden">
              <Image
                src={blade}
                format="webp"
                quality={80}
                widths={[240, 480]}
                sizes="240px"
                width={480}
                alt="夜行刃"
                class="size-full object-contain transition-[filter] duration-500 group-data-[dark=false]:grayscale motion-reduce:transition-none"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
              <h4 class="text-[22px] font-medium tracking-[0.08em]">夜行刃</h4>
              <button
                type="button"
                class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-line px-3 py-1.5 text-[12px] text-muted transition-colors hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent aria-pressed:border-accent/40 aria-pressed:bg-accent/10 aria-pressed:text-accent disabled:cursor-default"
                data-dark-toggle
                aria-label="黑暗场景"
                aria-pressed="true"
                disabled
              >
                <span
                  class="size-1.5 rounded-full bg-current"
                  aria-hidden="true"
                ></span>
                <span data-light-label>黑暗</span>
              </button>
            </div>
            <div class="mt-5 border-t border-line pt-5">
              <p class="text-[12px] text-muted">伤害</p>
              <p
                class="mt-2 flex items-baseline gap-3 whitespace-nowrap font-mono text-[clamp(30px,3.5vw,44px)] font-medium leading-tight tracking-[-0.05em]"
                role="status"
                aria-live="polite"
                aria-atomic="true"
              >
                <span>1d6</span>
                <span
