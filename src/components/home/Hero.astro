---
import { downloads, site } from '../../data/site';
import HeroBackdrop from './HeroBackdrop.astro';
import HeroScreenshots from './HeroScreenshots.astro';

const features = [
  { label: '本地运行', path: 'M4 4h16v12H4z M8 20h8 M12 16v4' },
  { label: '开源', path: 'm8 7-5 5 5 5 m8-10 5 5-5 5 m-3-14-2 18' },
  { label: '自由规则', path: 'M4 7h9 m4 0h3 M4 17h3 m4 0h9 M13 4v6 M7 14v6' },
];
---

<section
  class="relative isolate overflow-clip"
  data-hero
  aria-labelledby="hero-title"
>
  <HeroBackdrop />

  <div class="shell relative grid gap-10 pt-32 pb-12 sm:gap-12 sm:pt-36 sm:pb-16 lg:gap-14 lg:pt-36 lg:pb-20">
    <div class="relative z-10 mx-auto w-full max-w-200 text-center">
      <h1
        id="hero-title"
        class="font-display text-[clamp(2.25rem,5vw,4rem)] leading-[1.3] font-semibold tracking-tight"
        data-hero-title
        data-intro
      >
        {site.sloganLines.map((line, index) => (
          <span class:list={['block', { 'hero-title-tail': index > 0 }]}>
            {line}
          </span>
        ))}
      </h1>

      <p
        class="mx-auto mt-5 max-w-[40rem] text-[0.95rem] leading-8 text-muted sm:text-base"
        data-intro
      >
        TARP 是一款由 AI 主持的文字角色扮演应用。你描述角色的行动后，AI
        主持查阅模组资料、调用工具，并将行动带来的变化保存到文档中。
      </p>

      <div
        class="relative z-20 mt-7 flex flex-wrap items-center justify-center gap-3"
        data-intro
      >
        <div class="group/download relative">
          <a
            href="#downloads"
            data-download-primary
            class="inline-flex h-13 items-center justify-center gap-2.5 rounded-lg bg-foreground px-6 text-[0.95rem] font-medium text-canvas transition-colors hover:bg-foreground/85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <svg
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3v12 m-5-5 5 5 5-5 M4 16v5h16v-5" />
            </svg>
            <span>立即下载</span>
          </a>
          <div class="pointer-events-none invisible absolute top-full left-1/2 z-30 w-80 -translate-x-1/2 max-w-[calc(100vw-3rem)] translate-y-1 pt-3 opacity-0 transition-[opacity,translate,visibility] duration-200 group-hover/download:pointer-events-auto group-hover/download:visible group-hover/download:translate-y-0 group-hover/download:opacity-100 group-focus-within/download:pointer-events-auto group-focus-within/download:visible group-focus-within/download:translate-y-0 group-focus-within/download:opacity-100 motion-reduce:transition-none">
            <div class="rounded-2xl border border-line bg-surface p-2 text-left shadow-[0_24px_64px_-20px_var(--color-shadow),0_4px_12px_-6px_var(--color-shadow)]">
              <div class="flex items-center justify-between px-3 pt-2 pb-3">
                <span class="text-[11px] font-medium tracking-wide text-subtle">
                  选择平台
                </span>
                <label
                  class="flex cursor-pointer items-center gap-2.5 text-[11px] text-muted"
                  title="开启时通过 gh-proxy.com 下载，关闭时从 GitHub 下载"
                >
                  加速
                  <span class="relative inline-flex">
                    <input
                      type="checkbox"
                      role="switch"
                      aria-label="加速下载"
                      checked
                      data-download-accelerated
                      class="peer sr-only"
                    />
                    <span class="h-4.5 w-8 rounded-full bg-foreground/15 transition-colors peer-checked:bg-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-accent"></span>
                    <span class="pointer-events-none absolute top-0.5 left-0.5 size-3.5 rounded-full bg-white shadow-sm transition-transform peer-checked:translate-x-3.5 motion-reduce:transition-none"></span>
                  </span>
                </label>
              </div>
              <ul id="downloads" aria-label="选择下载平台" class="space-y-1">
                {downloads.map((download) => (
                  <li data-download-option class="group/platform">
                    <a
                      href={`https://gh-proxy.com/${download.href}`}
                      data-download-platform={download.label}
                      data-download-direct={download.href}
                      aria-label={`下载 ${download.label} ${download.architecture}`}
                      class="group/option flex items-center gap-3.5 rounded-xl border border-transparent px-3 py-3 text-foreground transition-colors hover:bg-foreground/5 focus-visible:outline-accent group-data-current/platform:border-accent/15 group-data-current/platform:bg-accent/8 group-data-current/platform:hover:bg-accent/13"
                    >
                      <svg
                        class="size-6 shrink-0 text-muted group-data-current/platform:text-accent"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        {download.label === 'Windows' ? (
                          <path d="M3 5.2 10.5 4v7.2H3V5.2Zm8.5-1.4L21 2.4v8.8h-9.5V3.8ZM3 12.3h7.5v7.2L3 18.3v-6Zm8.5 0H21v8.8l-9.5-1.4v-7.4Z" />
                        ) : download.label === 'macOS' ? (
                          <path d="M16.5 1.5c.1 1.3-.4 2.6-1.2 3.5-.9 1-2.1 1.5-3.4 1.4-.1-1.3.4-2.5 1.3-3.4.9-.9 2.1-1.5 3.3-1.5ZM20.2 17.7c-.5 1.2-.8 1.8-1.5 2.9-.9 1.3-2.1 3-3.6 3-1.4 0-1.8-.9-3.7-.9-1.8 0-2.3.9-3.7.9-1.5 0-2.6-1.5-3.5-2.8C1.7 17 1 11.9 2.5 9.4 3.6 7.6 5.4 6.5 7.2 6.5c1.6 0 2.6.9 3.9.9 1.3 0 2.1-.9 3.9-.9 1.5 0 3.1.8 4.2 2.1-3.7 2-3.1 7.3 1 9.1Z" />
                        ) : (
                          <path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.248 0 00-.183-.064h-.021c-.071.006-.13.04-.186.132a.552.552 0 00-.12.27.944.944 0 00-.023.33v.015c.012.135.037.2.08.334.046.134.098.2.166.268.01.009.02.018.034.024-.07.057-.117.07-.176.136a.304.304 0 01-.131.068 2.62 2.62 0 01-.275-.402 1.772 1.772 0 01-.155-.667 1.759 1.759 0 01.08-.668 1.43 1.43 0 01.283-.535c.128-.133.26-.2.418-.2zm1.37 1.706c.332 0 .733.065 1.216.399.293.2.523.269 1.052.468h.003c.255.136.405.266.478.399v-.131a.571.571 0 01.016.47c-.123.31-.516.643-1.063.842v.002c-.268.135-.501.333-.775.465-.276.135-.588.292-1.012.267a1.139 1.139 0 01-.448-.067 3.566 3.566 0 01-.322-.198c-.195-.135-.363-.332-.612-.465v-.005h-.005c-.4-.246-.616-.512-.686-.71-.07-.268-.005-.47.193-.6.224-.135.38-.271.483-.336.104-.074.143-.102.176-.131h.002v-.003c.169-.202.436-.47.839-.601.139-.036.294-.065.466-.065zm2.8 2.142c.358 1.417 1.196 3.475 1.735 4.473.286.534.855 1.659 1.102 3.024.156-.005.33.018.513.064.646-1.671-.546-3.467-1.089-3.966-.22-.2-.232-.335-.123-.335.59.534 1.365 1.572 1.646 2.757.13.535.16 1.104.021 1.67.067.028.135.06.205.067 1.032.534 1.413.938 1.23 1.537v-.043c-.06-.003-.12 0-.18 0h-.016c.151-.467-.182-.825-1.065-1.224-.915-.4-1.646-.336-1.77.465-.008.043-.013.066-.018.135-.068.023-.139.053-.209.064-.43.268-.662.669-.793 1.187-.13.533-.17 1.156-.205 1.869v.003c-.02.334-.17.838-.319 1.35-1.5 1.072-3.58 1.538-5.348.334a2.645 2.645 0 00-.402-.533 1.45 1.45 0 00-.275-.333c.182 0 .338-.03.465-.067a.615.615 0 00.314-.334c.108-.267 0-.697-.345-1.163-.345-.467-.931-.995-1.788-1.521-.63-.4-.986-.87-1.15-1.396-.165-.534-.143-1.085-.015-1.645.245-1.07.873-2.11 1.274-2.763.107-.065.037.135-.408.974-.396.751-1.14 2.497-.122 3.854a8.123 8.123 0 01.647-2.876c.564-1.278 1.743-3.504 1.836-5.268.048.036.217.135.289.202.218.133.38.333.59.465.21.201.477.335.876.335.039.003.075.006.11.006.412 0 .73-.134.997-.268.29-.134.52-.334.74-.4h.005c.467-.135.835-.402 1.044-.7zm2.185 8.958c.037.6.343 1.245.882 1.377.588.134 1.434-.333 1.791-.765l.211-.01c.315-.007.577.01.847.268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z" />
                        )}
                      </svg>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                          <span class="text-sm font-medium">
                            {download.label}
                          </span>
                          <span class="hidden items-center gap-1 text-[10px] text-accent group-data-current/platform:inline-flex">
                            <span class="size-1 rounded-full bg-current"></span>
                            本机
                          </span>
                        </div>
                        <p class="mt-0.5 text-[11px] text-subtle">
                          {download.architecture}
                        </p>
                      </div>
                      <svg
                        class="size-4 text-subtle transition-[color,translate] group-hover/option:translate-y-0.5 group-hover/option:text-foreground group-data-current/platform:text-accent motion-reduce:transition-none"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M12 3v12m-4-4 4 4 4-4M5 17v4h14v-4" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <ul
        class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-sm text-muted sm:gap-x-6"
        aria-label="产品特性"
        data-intro
      >
        {features.map((feature) => (
          <li class="inline-flex items-center gap-2">
            <svg
              class="size-4 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={feature.path} />
            </svg>
            {feature.label}
          </li>
        ))}
      </ul>
    </div>

    <div class="min-w-0">
      <HeroScreenshots />
    </div>
  </div>
</section>

<style>
  .hero-title-tail {
    color: var(--color-foreground);
    background: linear-gradient(
      105deg,
      var(--color-foreground) 0%,
      color-mix(
          in srgb,
          var(--color-foreground) 55%,
          var(--hero-title-accent, var(--color-accent))
        )
        40%,
      var(--hero-title-accent, var(--color-accent)) 100%
    );
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>

<script>
  const primary = document.querySelector<HTMLAnchorElement>(
    '[data-download-primary]',
  );
  const accelerated = document.querySelector<HTMLInputElement>(
    '[data-download-accelerated]',
  );
  const platformLinks = document.querySelectorAll<HTMLAnchorElement>(
    '[data-download-platform]',
  );
  const userAgent = navigator.userAgent;
  const platform = /Android|iPhone|iPad|iPod|Mobile/i.test(userAgent)
    ? undefined
    : /Windows NT/i.test(userAgent)
      ? 'Windows'
      : /Macintosh/i.test(userAgent)
        ? 'macOS'
        : /Linux/i.test(userAgent)
          ? 'Linux'
          : undefined;
  const download = platform
    ? document.querySelector<HTMLAnchorElement>(
        `[data-download-platform="${platform}"]`,
      )
    : null;

  function updateDownloadRoute() {
    platformLinks.forEach((link) => {
      const direct = link.dataset.downloadDirect;
      if (direct)
        link.href = accelerated?.checked
          ? `https://gh-proxy.com/${direct}`
          : direct;
    });
    if (primary && download) primary.href = download.href;
  }

  accelerated?.addEventListener('change', updateDownloadRoute);
  updateDownloadRoute();

  if (primary && download) {
    primary.href = download.href;
    const current = download.closest('[data-download-option]');
    if (current) {
      current.setAttribute('data-current', '');
      current.parentElement?.prepend(current);
    }
    primary.setAttribute('aria-label', `立即下载 TARP · ${platform}`);
  } else {
    primary?.addEventListener('click', (event) => {
      event.preventDefault();
      primary.focus();
    });
  }
</script>
