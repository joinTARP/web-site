---
import { site } from '../../data/site';
import HeroBackdrop from './HeroBackdrop.astro';
import HeroScreenshots from './HeroScreenshots.astro';

const features = [
  { label: '本地运行', path: 'M4 4h16v12H4z M8 20h8 M12 16v4' },
  { label: '开源', path: 'm8 7-5 5 5 5 m8-10 5 5-5 5 m-3-14-2 18' },
  { label: '自由规则', path: 'M4 7h9 m4 0h3 M4 17h3 m4 0h9 M13 4v6 M7 14v6' },
];
---

<section
  class="relative isolate overflow-clip"
  data-hero
  aria-labelledby="hero-title"
>
  <HeroBackdrop />

  <div class="shell relative grid gap-10 pt-32 pb-12 sm:gap-12 sm:pt-36 sm:pb-16 lg:gap-14 lg:pt-36 lg:pb-20">
    <div class="relative z-10 mx-auto w-full max-w-200 text-center">
      <h1
        id="hero-title"
        class="font-display text-[clamp(2.25rem,5vw,4rem)] leading-[1.3] font-semibold tracking-tight"
        data-hero-title
        data-intro
      >
        {site.sloganLines.map((line, index) => (
          <span class:list={['block', { 'hero-title-tail': index > 0 }]}>
            {line}
          </span>
        ))}
      </h1>

      <p
        class="mx-auto mt-5 max-w-[40rem] text-[0.95rem] leading-8 text-muted sm:text-base"
        data-intro
      >
        TARP 是一款由 AI 主持的文字角色扮演应用。你描述角色的行动后，AI
        主持查阅模组资料、调用工具，并将行动带来的变化保存到文档中。
      </p>

      <div
        class="mt-7 flex flex-wrap items-center justify-center gap-3"
        data-intro
      >
        <button
          type="button"
          class="inline-flex h-13 cursor-not-allowed items-center justify-center gap-2.5 rounded-lg bg-foreground px-6 text-[0.95rem] font-medium text-canvas"
          disabled
          title="安装包即将提供"
          aria-label="立即下载（安装包即将提供）"
        >
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v12 m-5-5 5 5 5-5 M4 16v5h16v-5" />
          </svg>
          立即下载
        </button>
      </div>

      <ul
        class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-sm text-muted sm:gap-x-6"
        aria-label="产品特性"
        data-intro
      >
        {features.map((feature) => (
          <li class="inline-flex items-center gap-2">
            <svg
              class="size-4 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={feature.path} />
            </svg>
            {feature.label}
          </li>
        ))}
      </ul>
    </div>

    <div class="min-w-0">
      <HeroScreenshots />
    </div>
  </div>
</section>

<style>
  .hero-title-tail {
    color: var(--color-foreground);
    background: linear-gradient(
      105deg,
      var(--color-foreground) 0%,
      color-mix(
          in srgb,
          var(--color-foreground) 55%,
          var(--hero-title-accent, var(--color-accent))
        )
        40%,
      var(--hero-title-accent, var(--color-accent)) 100%
    );
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
