---
import { Image } from 'astro:assets';
import sutang from '../../assets/demo/sutang.webp';
import avatar from '../../assets/demo/sutang-avatar.webp';
import HostAvatar from '../demo/HostAvatar';
import CompanionDemo from '../demo/CompanionDemo';

const companionDialogue = '小心！那边好像有陷阱！';
---

<section
  id="companions"
  class="companions-section relative isolate overflow-clip py-[clamp(72px,8vw,112px)]"
  aria-labelledby="companions-title"
>
  <div class="shell">
    <div
      class="companion-lead grid items-center gap-12 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] lg:gap-16"
      data-companion-assembly
    >
      <div class="companion-copy max-w-130 lg:max-w-110" data-companion-copy>
        <h2
          id="companions-title"
          class="font-display text-[1.875rem] leading-[1.35] font-semibold tracking-tight sm:text-[2rem] lg:text-[clamp(2.25rem,3vw,2.5rem)]"
        >
          无社交压力，
          <br />
          <span class="text-accent">AI 做你的队友。</span>
        </h2>
        <p class="mt-5 text-base leading-8 text-pretty text-muted">
          选好角色，让 AI
          加入你的队伍。它会按角色的性格和经历参与讨论，提出自己的行动。你照常玩自己的角色。
        </p>
        <p class="mt-4 text-base leading-8 text-pretty text-muted">
          不用约时间，也不用担心冷场。想听队友的看法，直接{' '}
          <span class="companion-mention inline-flex items-center rounded-md border border-accent/30 bg-accent/10 px-1.5 py-0.5 font-mono text-[0.9em] leading-none font-medium whitespace-nowrap text-accent">
            @ 它
          </span>
          。
        </p>
        <a
          class="companion-link group/companion mt-6 inline-flex items-center gap-3 text-sm font-medium transition-colors hover:text-accent"
          href="/docs/play/companions/"
        >
          看看队友怎么玩
          <span
            class="transition-transform duration-300 group-hover/companion:translate-x-1"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      </div>

      <figure
        class="companion-character relative mx-auto w-full max-w-140 min-h-[clamp(380px,90vw,500px)] isolate select-none sm:min-h-122 lg:min-h-130"
        data-companion-visual
      >
        <!-- 舞台环境光晕 -->
        <div
          class="companion-character-aura pointer-events-none absolute -z-2 top-[4%] right-[8%] bottom-[8%] left-[8%] rounded-full"
          aria-hidden="true"
          data-companion-aura
        ></div>

        <!-- 角色拱门背板与坐标网格 -->
        <div
          class="companion-character-backdrop light:shadow-panel pointer-events-none absolute -z-1 top-[9%] right-[14%] bottom-[4%] left-[14%] overflow-hidden rounded-t-[999px] rounded-b-3xl border border-line bg-surface/75 shadow-[0_24px_60px_-32px_var(--color-shadow)] max-sm:right-[10%] max-sm:left-[10%]"
          aria-hidden="true"
          data-companion-backdrop
        >
          <div class="companion-stage-grid light:opacity-25 absolute inset-0 [background-size:18px_18px] opacity-15"></div>
          <div class="absolute inset-2.5 rounded-t-[999px] rounded-b-[18px] border border-accent/18"></div>
          <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-canvas/85 via-canvas/30 to-transparent light:from-surface/90 light:via-surface/30"></div>
        </div>

        <!-- 角色立绘主体 -->
        <div
          class="companion-portrait-wrap relative mx-auto w-[78%] max-w-108 pt-2 sm:w-[76%]"
          data-companion-portrait
        >
          <Image
            class="companion-character-portrait relative block aspect-2/3 w-full object-contain [filter:drop-shadow(0_22px_32px_rgba(0,0,0,0.34))] light:[filter:drop-shadow(0_18px_28px_rgba(32,40,48,0.14))]"
            src={sutang}
            format="webp"
            quality={80}
            widths={[320, 460, 640, 920]}
            sizes="(max-width: 768px) 78vw, 432px"
            alt="宝藏猎人苏棠的完整角色肖像"
            width={920}
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- 聊天气泡 -->
        <blockquote
          class="companion-character-quote light:shadow-panel absolute right-2 bottom-2 z-3 w-max max-w-[calc(100%-24px)] rounded-[18px_18px_18px_4px] border border-[color-mix(in_srgb,var(--color-accent)_38%,var(--color-line))] bg-surface/95 px-6 py-4 shadow-[0_18px_42px_-20px_var(--color-shadow)] backdrop-blur-md before:absolute before:-top-1.5 before:left-7 before:size-2.5 before:[transform:rotate(45deg)] before:border-t before:border-l before:border-t-[color-mix(in_srgb,var(--color-accent)_38%,var(--color-line))] before:border-l-[color-mix(in_srgb,var(--color-accent)_38%,var(--color-line))] before:bg-surface before:content-[''] max-sm:right-1/2 max-sm:translate-x-1/2 max-sm:px-5 max-sm:py-3.5"
          data-companion-quote
        >
          <p class="min-w-[12em] min-h-[1.75em] text-[17px] leading-[1.75] text-foreground max-sm:text-[15px]">
            <span class="sr-only">{companionDialogue.replace('\n', '')}</span>
            <span
              class="whitespace-pre-line [&[data-typing]::after]:ml-[3px] [&[data-typing]::after]:inline-block [&[data-typing]::after]:h-[1em] [&[data-typing]::after]:w-[1.5px] [&[data-typing]::after]:bg-accent [&[data-typing]::after]:content-[''] [&[data-typing]::after]:[vertical-align:-0.12em]"
              aria-hidden="true"
              data-companion-dialogue
              data-dialogue-text={companionDialogue}
            >
              {companionDialogue}
            </span>
          </p>
        </blockquote>
      </figure>
    </div>

    <div
      class="companion-details grid grid-cols-2 grid-rows-[auto_auto] gap-y-7 mt-16 pt-10 border-t border-t-line max-md:grid-cols-[minmax(0,1fr)] max-md:gap-10 max-md:mt-12 max-md:pt-8"
      data-companion-details
    >
      <article
        class="companion-detail grid grid-rows-subgrid [grid-row:span_2] min-w-0 pr-10 [&_+_.companion-detail]:pr-0 [&_+_.companion-detail]:pl-10 [&_+_.companion-detail]:border-l [&_+_.companion-detail]:border-l-line max-lg:pr-6 max-lg:[&_+_.companion-detail]:pl-6 max-md:grid-rows-[auto_auto] max-md:[grid-row:auto] max-md:gap-y-6 max-md:border-l-0 max-md:[&_+_.companion-detail]:grid-rows-[auto_auto] max-md:[&_+_.companion-detail]:[grid-row:auto] max-md:[&_+_.companion-detail]:gap-y-6 max-md:[&_+_.companion-detail]:border-l-0 max-md:[&_+_.companion-detail]:pt-8 max-md:[&_+_.companion-detail]:border-t max-md:[&_+_.companion-detail]:border-t-line max-md:px-0 max-md:[&_+_.companion-detail]:px-0"
        data-companion-detail
      >
        <header class="companion-detail-heading mb-0 [&_h3]:text-[22px] [&_h3]:font-medium [&_h3]:leading-[1.6] [&_p]:mt-3 [&_p]:text-muted [&_p]:text-[14px] [&_p]:leading-[1.9] [&_p]:text-pretty max-lg:[&_h3]:text-[20px] max-md:mb-0 max-md:[&_h3]:text-[21px]">
          <h3>队友怎么参与，你来定</h3>
          <p>
            话多一点，还是安静一点？调整主动性就行。
            <br class="desktop-break max-lg:hidden" />
            每个队友也可以单独选模型。
          </p>
        </header>
        <div class="companion-settings-preview grid">
          <CompanionDemo client:visible />
        </div>
      </article>

      <article
        class="companion-detail grid grid-rows-subgrid [grid-row:span_2] min-w-0 pr-10 [&_+_.companion-detail]:pr-0 [&_+_.companion-detail]:pl-10 [&_+_.companion-detail]:border-l [&_+_.companion-detail]:border-l-line max-lg:pr-6 max-lg:[&_+_.companion-detail]:pl-6 max-md:grid-rows-[auto_auto] max-md:[grid-row:auto] max-md:gap-y-6 max-md:border-l-0 max-md:[&_+_.companion-detail]:grid-rows-[auto_auto] max-md:[&_+_.companion-detail]:[grid-row:auto] max-md:[&_+_.companion-detail]:gap-y-6 max-md:[&_+_.companion-detail]:border-l-0 max-md:[&_+_.companion-detail]:pt-8 max-md:[&_+_.companion-detail]:border-t max-md:[&_+_.companion-detail]:border-t-line max-md:px-0 max-md:[&_+_.companion-detail]:px-0"
        data-companion-detail
      >
        <header class="companion-detail-heading mb-0 [&_h3]:text-[22px] [&_h3]:font-medium [&_h3]:leading-[1.6] [&_p]:mt-3 [&_p]:text-muted [&_p]:text-[14px] [&_p]:leading-[1.9] [&_p]:text-pretty max-lg:[&_h3]:text-[20px] max-md:mb-0 max-md:[&_h3]:text-[21px]">
          <h3>队友不读取主持的幕后资料</h3>
          <p>
            AI 像真人玩家一样扮演角色。
            <br class="desktop-break max-lg:hidden" />
            每位队友都有独立记忆，只知道自己经历过的事。
          </p>
        </header>
        <div class="companion-memory-preview light:shadow-panel grid grid-rows-[auto_auto_1fr] min-w-0 overflow-hidden border border-line rounded-[12px] bg-surface">
          <div class="companion-host-memory pt-6 pb-5 bg-[color-mix(_in_srgb,_var(--color-canvas)_55%,_var(--color-surface)_)] [&_>_p]:mt-3.5 [&_>_p]:text-[17px] [&_>_p]:leading-[1.8] px-7 max-md:p-5">
            <div class="companion-memory-owner flex items-center gap-2.5 text-muted text-[13px] [&_img]:rounded-full [&_img]:object-cover [&_img]:size-7">
              <span class="size-7 shrink-0">
                <HostAvatar />
              </span>
              <span>主持人的幕后资料</span>
            </div>
            <p>
              下陷的地砖是安全的。紧挨着它北侧的平整地砖才是机关，踩上去就会触发。
            </p>
            <span class="companion-host-note block mt-1.5 text-subtle text-[12px] leading-[1.8]">
              机关位置、触发条件、检定规则
            </span>
          </div>
          <div class="companion-memory-boundary flex items-center gap-2.5 text-accent [&_>_span]:h-[1px] [&_>_span]:flex-1 [&_>_span]:bg-[color-mix(in_srgb,_var(--color-accent)_35%,_var(--color-line))] [&_svg]:shrink-0 [&_p]:text-[12px] [&_p]:tracking-[0.1em] [&_p]:leading-[2] px-7 max-md:px-5">
            <span aria-hidden="true"></span>
            <svg
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="5" y="10" width="14" height="11" rx="2" />
              <path d="M8 10V6a4 4 0 0 1 8 0v4" />
              <path d="M12 14v3" />
            </svg>
            <p>独立记忆</p>
            <span aria-hidden="true"></span>
          </div>
          <article class="companion-player-memory flex flex-col [&_header]:flex [&_header]:items-center [&_header]:gap-3.5 [&_header_img]:shrink-0 [&_header_img]:rounded-full [&_header_img]:bg-[color-mix(in_srgb,_var(--color-accent)_8%,_var(--color-canvas))] [&_header_img]:object-cover [&_h4]:text-[19px] [&_h4]:font-medium [&_h4]:leading-[1.5] [&_header_p]:mt-1 [&_header_p]:text-subtle [&_header_p]:text-[12px] [&_header_p]:leading-[1.8] [&_blockquote]:mt-auto [&_blockquote]:pt-4.5 [&_blockquote]:border-t [&_blockquote]:border-t-line [&_blockquote]:text-[16px] [&_blockquote]:leading-[1.8] [&_blockquote]:text-accent py-6 px-7 [&_header_img]:size-12 max-md:p-5">
            <header>
              <Image
                src={avatar}
                format="webp"
                quality={80}
                widths={[48, 96]}
                sizes="48px"
                alt=""
                width={48}
                loading="lazy"
              />
              <div>
                <h4>苏棠的记忆</h4>
              </div>
            </header>
            <ol class="companion-memory-events relative grid gap-4.5 pl-4.5 list-none before:content-[''] before:absolute before:right-auto before:left-[3px] before:w-[1px] before:bg-[color-mix(in_srgb,_var(--color-accent)_30%,_var(--color-line))] [&_li]:relative [&_li]:grid [&_li]:grid-cols-[40px_minmax(0,_1fr)] [&_li]:gap-3.5 [&_li]:text-[14px] [&_li]:leading-[1.8] [&_li::before]:content-[''] [&_li::before]:absolute [&_li::before]:top-2.5 [&_li::before]:-left-4.5 [&_li::before]:border [&_li::before]:border-accent [&_li::before]:rounded-full [&_li::before]:bg-surface [&_li:last-child::before]:bg-accent [&_li_>_span]:text-subtle my-6 before:inset-y-3 [&_li::before]:size-[7px]">
              <li>
                <span>场景</span>
                <p>前方传来呼救声。</p>
              </li>
              <li>
                <span>线索</span>
                <p>通道中段有一块地砖下陷开裂。</p>
              </li>
              <li>
                <span>分析</span>
                <p>下陷的地砖存在危险。</p>
              </li>
            </ol>
            <blockquote>“{companionDialogue.replace('\n', '')}”</blockquote>
          </article>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .companion-character-aura {
    background: radial-gradient(
      ellipse at 52% 44%,
      color-mix(in srgb, var(--color-accent) 18%, transparent),
      color-mix(in srgb, var(--color-ambient) 6%, transparent) 45%,
      transparent 72%
    );
  }
  .companion-stage-grid {
    background-image: radial-gradient(
      var(--color-subtle) 0.75px,
      transparent 0.75px
    );
    mask-image: radial-gradient(ellipse at 50% 36%, #000 18%, transparent 72%);
  }
  [data-companion-dialogue][data-typing]::after {
    animation: blink 0.8s steps(1) infinite;
  }
  .companion-memory-boundary {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-canvas) 55%, var(--color-surface)) 50%,
      var(--color-surface) 50%
    );
  }
</style>
