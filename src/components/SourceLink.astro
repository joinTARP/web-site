---
import { sourceHref } from '../data/site';

const label = sourceHref ? '在 GitHub 查看源码' : 'GitHub 仓库地址待配置';
---

<a
  href={sourceHref}
  target={sourceHref ? '_blank' : undefined}
  rel={sourceHref ? 'noopener noreferrer' : undefined}
  role={sourceHref ? undefined : 'link'}
  aria-label={label}
  title={label}
  aria-disabled={sourceHref ? undefined : 'true'}
  tabindex={sourceHref ? undefined : -1}
  class:list={[
    'grid size-10 shrink-0 place-items-center rounded-full text-muted transition-colors hover:bg-foreground/8 hover:text-foreground',
    { 'cursor-default': !sourceHref },
  ]}
>
  <svg
    class="size-5"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.42-1.305.763-1.605-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.468-2.382 1.235-3.222-.123-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.51 11.51 0 0 1 3.003-.404c1.02.005 2.045.138 3.003.404 2.291-1.552 3.297-1.23 3.297-1.23.654 1.652.242 2.873.12 3.176.77.84 1.233 1.912 1.233 3.222 0 4.61-2.807 5.622-5.479 5.918.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 21.796 24 17.3 24 12c0-6.627-5.373-12-12-12Z" />
  </svg>
</a>
