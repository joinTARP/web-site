---
import { modulesHref, site, startHref } from '../data/site';

const groups = [
  {
    title: '产品',
    links: [
      { label: 'AI 主持', href: '/docs/play/ai-host/' },
      { label: 'AI 队友', href: '/docs/play/companions/' },
      { label: '模组创作', href: '/docs/modules/structure/' },
      { label: '常见问题', href: '/docs/reference/faq/' },
    ],
  },
  {
    title: '资源',
    links: [
      { label: '快速开始', href: startHref },
      { label: '模组库', href: modulesHref },
      { label: '文档', href: '/docs/' },
      { label: '更新记录', href: '/releases/' },
    ],
  },
];
---

<footer class="site-footer bg-canvas text-foreground">
  <div class="border-t border-foreground/10 pt-20">
    <div class="shell grid gap-14 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-xl leading-relaxed font-bold">TARP</p>
        <p class="mt-3 text-sm text-muted">{site.slogan}</p>
        <p class="mt-6 max-w-sm text-sm leading-7 text-subtle">
          当前为 {site.version}
          ，支持 Windows x64、macOS Apple Silicon 和 Linux x64。使用方法见文档。
        </p>
      </div>
      {groups.map((group) => (
        <nav aria-label={group.title}>
          <h2 class="text-sm text-subtle">{group.title}</h2>
          <ul class="mt-5 space-y-3">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={
                    link.href.startsWith('https://') ? '_blank' : undefined
                  }
                  rel={
                    link.href.startsWith('https://')
                      ? 'noopener noreferrer'
                      : undefined
                  }
                  aria-label={
                    link.href.startsWith('https://')
                      ? `${link.label}（GitHub，新标签页）`
                      : undefined
                  }
                  class="relative text-[0.92rem] text-muted transition-colors after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-right after:scale-x-0 after:bg-current after:transition-transform after:duration-500 after:ease-expo hover:text-foreground hover:after:origin-left hover:after:scale-x-100"
                >
                  {link.label}
                  {link.href.startsWith('https://') && (
                    <span aria-hidden="true">↗</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="shell mt-20 flex flex-wrap items-center justify-between gap-4 border-t border-foreground/10 py-6 text-xs text-subtle">
      <p>© {new Date().getFullYear()} TARP</p>
      <p>{site.version}</p>
    </div>
  </div>
</footer>
