---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import Pending from '../../components/Pending.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { formatDate, getPosts } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <article class="mx-auto max-w-3xl">
    <a
      href="/blog/"
      class="text-sm text-subtle transition-colors hover:text-foreground"
    >
      ← 返回开发日志
    </a>
    <header class="mt-10 border-b border-foreground/10 pb-10">
      <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-subtle">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {post.data.tags.map((tagName) => (
          <span class="text-accent">#{tagName}</span>
        ))}
      </div>
      <h1 class="mt-4 font-display text-[clamp(1.75rem,3vw,2.5rem)] leading-snug font-bold tracking-wide">
        {post.data.title}
      </h1>
      <p class="mt-4 leading-8 text-muted">{post.data.description}</p>
    </header>

    <div class="mt-10">
      {post.data.draft ? (
        <Pending title="文章待完善">
          <Content />
        </Pending>
      ) : (
        <div class="prose prose-lg dark:prose-invert prose-headings:font-display prose-a:text-link [&_.expressive-code]:my-6">
          <Content />
        </div>
      )}
    </div>
  </article>
</BlogLayout>
