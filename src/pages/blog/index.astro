---
import Pending from '../../components/Pending.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { formatDate, getPosts } from '../../lib/blog';

const posts = await getPosts();
---

<BlogLayout title="开发日志" description="TARP 的开发进展与版本说明。">
  <div>
    <header class="grid items-end gap-8 border-b border-foreground/10 pb-14 md:grid-cols-[1fr_auto]">
      <div>
        <Eyebrow>开发日志</Eyebrow>
        <h1 class="mt-4 font-display text-[clamp(1.875rem,3.4vw,2.75rem)] leading-snug font-bold tracking-wide [&_em]:text-accent [&_em]:not-italic">
          TARP <em>开发日志</em>
        </h1>
      </div>
      <p class="max-w-sm text-sm leading-7 text-muted">
        记录功能进展、版本调整和开发中的取舍。
      </p>
    </header>

    {posts.length === 0 ? (
      <Pending title="文章待完善" class="mt-14">
        目前还没有发布文章。
      </Pending>
    ) : (
      <ul class="mt-6">
        {posts.map((post) => (
          <li class="border-b border-foreground/10">
            <a
              href={`/blog/${post.id}/`}
              class="group grid gap-3 py-10 md:grid-cols-[180px_1fr_auto] md:items-baseline md:gap-10"
            >
              <time
                class="font-mono text-xs text-subtle"
                datetime={post.data.date.toISOString()}
              >
                {formatDate(post.data.date)}
              </time>
              <div>
                <h2 class="font-display text-2xl font-bold transition-colors group-hover:text-link md:text-3xl">
                  {post.data.title}
                  {post.data.draft && (
                    <span class="ml-3 align-middle font-sans text-xs font-normal text-accent">
                      草稿
                    </span>
                  )}
                </h2>
                <p class="mt-3 text-sm leading-7 text-muted">
                  {post.data.description}
                </p>
              </div>
              <span
                class="hidden text-xl text-subtle transition-transform duration-500 ease-expo group-hover:translate-x-2 group-hover:text-foreground md:block"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BlogLayout>
