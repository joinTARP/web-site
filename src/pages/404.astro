---
import Contour from '../components/Contour.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" footer={false} noindex>
  <section class="relative isolate flex min-h-svh items-center overflow-hidden">
    <Contour
      class="absolute top-1/2 left-1/2 -z-10 w-[max(120vw,1100px)] -translate-1/2 text-foreground/6 [mask:radial-gradient(closest-side,#000_30%,transparent)]"
      seed={7}
    />
    <div class="shell">
      <Eyebrow>404</Eyebrow>
      <h1
        class="mt-5 font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-snug font-bold tracking-wide [&_em]:text-accent [&_em]:not-italic"
        data-split
      >
        <em>找不到这个页面</em>。
      </h1>
      <p class="mt-8 text-muted" data-reveal>
        链接可能有误，或页面已经移走。可以回到首页继续查看。
      </p>
      <div class="mt-10" data-reveal>
        <Button href="/" arrow="↗">
          返回首页
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
