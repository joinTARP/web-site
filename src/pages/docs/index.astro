---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docHref, getDocsTree } from '../../lib/docs';

const tree = await getDocsTree();
const headings = tree.map((section) => ({
  depth: 2,
  slug: 'section-' + section.id,
  text: section.title,
}));
---

<DocsLayout
  title="文档"
  description="TARP 使用与模组创作文档。"
  headings={headings}
>
  <header class="border-b border-line pb-7">
    <p class="text-xs text-subtle">使用手册</p>
    <h1 class="mt-3 font-display text-[30px] leading-snug font-semibold tracking-[-0.025em] sm:text-[34px]">
      TARP 文档
    </h1>
    <p class="mt-4 text-[15px] leading-7 text-muted">
      第一次使用，先看
      <a
        href="/docs/getting-started/introduction/"
        class="text-link underline decoration-link/40 underline-offset-4 hover:decoration-current"
      >
        认识 TARP
      </a>
      ，准备应用后，再按“第一次冒险”连接模型、载入模组并选好角色。想写自己的故事，可以从
      <a
        href="/docs/modules/structure/"
        class="text-link underline decoration-link/40 underline-offset-4 hover:decoration-current"
      >
        模组结构
      </a>
      开始。
    </p>
    <p class="mt-5 border-l-2 border-accent bg-canvas px-4 py-3 text-[13px] leading-6 text-muted">
      文档对应 v0.1 试验性版本，安装包即将提供。
    </p>
  </header>

  <div>
    {tree.map((section) => (
      <section
        class="border-b border-line py-8 last:border-0"
        aria-labelledby={'section-' + section.id}
      >
        <div class="flex items-baseline justify-between gap-4">
          <h2
            id={'section-' + section.id}
            data-doc-heading
            class="text-xl font-semibold tracking-[-0.015em]"
          >
            {section.title}
          </h2>
          <span class="shrink-0 font-mono text-[11px] text-subtle">
            {section.entries.length} 篇
          </span>
        </div>
        <p class="mt-2 text-sm leading-6 text-muted">{section.description}</p>
        <ul class="mt-4">
          {section.entries.map((entry) => (
            <li class="border-b border-line/65 last:border-0">
              <a
                href={docHref(entry)}
                class="group flex items-start gap-3 py-3.5"
              >
                <svg
                  class="mt-0.5 size-4 shrink-0 text-subtle transition-colors group-hover:text-link"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M11.5 2.5H5a1.5 1.5 0 0 0-1.5 1.5v12A1.5 1.5 0 0 0 5 17.5h10a1.5 1.5 0 0 0 1.5-1.5V7.5m-5-5 5 5h-5v-5M6.5 11h7m-7 3h5" />
                </svg>
                <span class="min-w-0 flex-1">
                  <span class="text-[14px] font-medium transition-colors group-hover:text-link">
                    {entry.data.title}
                  </span>
                  {entry.data.description && (
                    <span class="mt-1 block text-[13px] leading-6 text-subtle">
                      {entry.data.description}
                    </span>
                  )}
                </span>
                {entry.data.status === 'draft' && (
                  <span class="shrink-0 text-[11px] leading-6 text-subtle">
                    待完善
                  </span>
                )}
                <span
                  class="mt-0.5 text-sm text-subtle transition-colors group-hover:text-link"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</DocsLayout>
