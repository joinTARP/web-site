---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Pending from '../../components/Pending.astro';
import ReleaseList from '../../components/ReleaseList.astro';
import DocOutline from '../../components/docs/DocOutline.astro';
import DocProse from '../../components/docs/DocProse.astro';
import { docsSections } from '../../data/site';
import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  docHref,
  getSortedDocs,
  sectionOf,
  type DocEntry,
} from '../../lib/docs';

export const getStaticPaths = (async () => {
  const docs = await getSortedDocs();
  return docs.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[index - 1], next: docs[index + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: DocEntry;
  prev?: DocEntry;
  next?: DocEntry;
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const section = docsSections.find((item) => item.id === sectionOf(entry));
const outline = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={entry.data.status === 'published' ? headings : []}
>
  <article class="doc-article">
    <header class="border-b border-line pb-7">
      <nav
        class="flex items-center gap-2 text-xs text-subtle"
        aria-label="当前位置"
      >
        <a href="/docs/" class="transition-colors hover:text-foreground">
          文档
        </a>
        <span aria-hidden="true">/</span>
        <span>{section?.title}</span>
      </nav>
      <h1 class="mt-5 font-display text-[30px] leading-[1.35] font-semibold tracking-[-0.025em] sm:text-[34px]">
        {entry.data.title}
      </h1>
      {entry.data.description && (
        <p class="mt-4 text-[15px] leading-7 text-muted">
          {entry.data.description}
        </p>
      )}
    </header>

    {entry.data.status === 'published' && outline.length > 0 && (
      <details class="group mt-6 border-y border-line bg-canvas px-4 py-3 xl:hidden">
        <summary class="flex cursor-pointer list-none items-center justify-between text-[13px] font-medium text-muted [&::-webkit-details-marker]:hidden">
          本页目录
          <svg
            class="size-4 text-subtle transition-transform group-open:rotate-180"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="m5 8 5 5 5-5" />
          </svg>
        </summary>
        <div class="pt-3">
          <DocOutline headings={outline} showTitle={false} />
        </div>
      </details>
    )}

    <div class="mt-7">
      {entry.data.status === 'draft' ? (
        <Pending>
          <Content />
        </Pending>
      ) : (
        <DocProse>
          <Content />
        </DocProse>
      )}
    </div>

    {entry.id === 'reference/changelog' && <ReleaseList />}

    <nav
      class="mt-12 grid gap-6 border-t border-line pt-6 sm:grid-cols-2"
      aria-label="上一篇与下一篇"
    >
      {prev && (
        <a href={docHref(prev)} class="group py-2">
          <span class="text-xs text-subtle">上一篇</span>
          <span class="mt-2 flex items-center gap-2 text-sm font-medium transition-colors group-hover:text-link">
            <span class="text-subtle" aria-hidden="true">
              ←
            </span>
            {prev.data.title}
          </span>
        </a>
      )}
      {next && (
        <a href={docHref(next)} class="group py-2 text-right sm:col-start-2">
          <span class="text-xs text-subtle">下一篇</span>
          <span class="mt-2 flex items-center justify-end gap-2 text-sm font-medium transition-colors group-hover:text-link">
            {next.data.title}
            <span class="text-subtle" aria-hidden="true">
              →
            </span>
          </span>
        </a>
      )}
    </nav>
  </article>
</DocsLayout>
