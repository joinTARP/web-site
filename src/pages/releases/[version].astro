---
import type { GetStaticPaths } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import DocProse from '../../components/docs/DocProse.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { formatDate, getReleases } from '../../lib/releases';

export const getStaticPaths = (async () => {
  const releases = await getReleases();
  return releases.map((release) => ({
    params: { version: release.data.version },
    props: { release },
  }));
}) satisfies GetStaticPaths;

interface Props {
  release: CollectionEntry<'releases'>;
}

const { release } = Astro.props;
const { Content } = await render(release);
const title = `TARP v${release.data.version}`;
---

<ContentLayout title={title} description={`${title} 正式版本更新说明。`}>
  <article class="mx-auto max-w-3xl">
    <a
      href="/releases/"
      class="text-sm text-subtle transition-colors hover:text-link"
    >
      ← 返回更新记录
    </a>
    <header class="mt-7 border-b border-line pb-7">
      <p class="text-xs text-subtle">版本更新</p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight">
        {title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-subtle">
        <time datetime={release.data.date.toISOString()}>
          {formatDate(release.data.date)}
        </time>
      </div>
    </header>
    <div class="mt-7">
      <DocProse>
        <Content />
      </DocProse>
    </div>
  </article>
</ContentLayout>
